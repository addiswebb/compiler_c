// RUN: %cc %s -a -o %t.s
// RUN: gcc %t.s -o %t
// RUN: %check_exit 8 %t

int main() {
    int a = 5;    // 0101
    int b = 3;    // 0011
    int c = (a & b) | (a ^ b); // (0101 & 0011)=0001, (0101^0011)=0110 => 0001|0110=0111=7
    int d = !(a > b) || (b & 1); // !(5>3)=0, (3&1)=1 => 0||1=1
    return c + d; // 7+1=8
}

// RUN: %cc %s -a -o %t.s
// RUN: gcc %t.s -o %t.exe
// RUN: pwsh -c "%t.exe ; %check_exit 1 $LASTEXITCODE"

int main() {
    char a = 120;
    char b = 10;
    int x = a + b << 1 > 250 || a & 1;
    // a+b = 130
    // 130 << 1 = 260
    // 260 > 250 = 1
    // a&1 = 0
    // 1 || 0 = 1
    return x;
}

// RUN: %cc %s -a -o %t.s
// RUN: gcc %t.s -o %t.exe
// RUN: pwsh -c "%t.exe ; %check_exit 403 $LASTEXITCODE"

int main() {
    int sum = 0;

    for (int i = 0; i < 5; i++) {
        switch (i) {
        case 2:
            continue;   // skips sum += 100
        case 3:
            break;      // exits switch only
        default:
            sum += 1;
        }
        sum += 100;
    }

    return sum;
}

// RUN: %cc %s -a -o %t.s
// RUN: gcc %t.s -o %t.exe
// RUN: pwsh -c "%t.exe ; %check_exit -3 $LASTEXITCODE"

int main() {
    int sum = 0;
    for (int i = 1; i <= 5; i++) {
        if (i % 2 == 0) sum += i; // sum even numbers
        else sum -= i;            // subtract odd numbers
    }
    return sum; // -1+2-3+4-5 = -3
}

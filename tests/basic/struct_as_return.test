// RUN: %cc %s -a -o %t.s
// RUN: gcc %t.s -o %t
// RUN: %check_exit 21 %t

struct L {
    int x;
    char y;
    char z;
};

struct S {
    char x;
    char y;
    int a;
};

struct L make_large() {
    struct L l = {1, 2, 3};
    return l;
}

struct S make_small() {
    struct S s = {4, 5, 6};
    return s;
}

int main() {
    struct L l = make_large();
    struct S s = make_small();
    return l.x + l.y + l.z + s.a + s.x + s.y;
}

// RUN: %cc %s -a -o %t.s
// RUN: gcc %t.s -o %t
// RUN: %t | %check_output "1 1 0 0 0 1 0 0 1 1 0 1 -120 120 -3 3 -2 2"
extern int printf(const char *format, ...);

int main() {

    int sa = -20;
    int sb = 6;

    unsigned int ua = 20;
    unsigned int ub = 6;

    /* signed comparisons */
    printf("%d ", sa < sb);
    printf("%d ", sa <= sb);
    printf("%d ", sa > sb);
    printf("%d ", sa >= sb);
    printf("%d ", sa == sb);
    printf("%d ", sa != sb);

    /* unsigned comparisons */
    printf("%d ", ua < ub);
    printf("%d ", ua <= ub);
    printf("%d ", ua > ub);
    printf("%d ", ua >= ub);
    printf("%d ", ua == ub);
    printf("%d ", ua != ub);

    /* signed multiplication */
    printf("%d ", sa * sb);

    /* unsigned multiplication */
    printf("%u ", ua * ub);

    /* signed division */
    printf("%d ", sa / sb);

    /* unsigned division */
    printf("%u ", ua / ub);

    /* signed modulo */
    printf("%d ", sa % sb);

    /* unsigned modulo */
    printf("%u\n", ua % ub);

    return 0;
}

// RUN: %cc %s -a -o %t.s
// RUN: gcc %t.s -o %t
// RUN: %t | %check_output "1.000000 11223341 5 2.500000 10 20 12345 42 x 1.000000 1.000000 123 B 0.000000"

extern int printf(const char *format, ...);

// Basic unions
typedef union {
    int i;
    float f;
} U1;
typedef union {
    int i;
    float f;
    char c;
} U2;
typedef union {
    int a;
    float b;
} U3;
typedef union {
    int i;
    float f;
} U4;

// Struct + union
typedef struct {
    int x;
    int y;
} P5;
typedef union {
    int i;
    P5 p;
} U5;

// Simple unions for assignment and pointers
typedef union {
    int i;
    float f;
} U6;
typedef union {
    int i;
    float f;
} U7;

// Nested union inside union
typedef union {
    float f;
    char c;
} Inner8;
typedef union {
    int a;
    Inner8 inner;
} U8;

// Compound literal union
typedef union {
    int i;
    float f;
} U9;

// Bit reinterpretation union
typedef union {
    float f;
    unsigned int i;
} U10;

// Struct containing union
typedef union {
    int i;
    float f;
} U11;
typedef struct {
    char tag;
    U11 value;
} Node11;

// Simple union for character test
typedef union {
    int i;
    float f;
    char c;
} U12;

// Pointer reinterpretation union
typedef union {
    int i;
    float f;
} U13;

int main() {

    U1 u1 = {.i = 0x3f800000}; // bit pattern for 1.0f
    U2 u2 = {.i = 0x11223344};
    u2.c = 'A'; // overwrite last byte
    U3 u3 = {.a = 5};
    U4 u4 = {.f = 2.5f};

    U5 u5;
    u5.i = 0; // initialize first member
    u5.p.x = 10;
    u5.p.y = 20;

    U6 u6 = {.i = 12345};
    U7 u7 = {.i = 42};

    U8 u8;
    u8.inner.c = 'x';

    U9 u9 = {.i = 1065353216}; // will reinterpret as float
    U10 u10 = {.f = 1.0f};

    Node11 n11;
    n11.tag = 1;
    n11.value.i = 123;

    U12 u12 = {.c = 'B'};

    U13 u13 = {.i = 77}; // reinterpret as float
    printf("%f %x %d %f %d %d %d %d %c %f %f %d %c %f\n", u1.f, u2.i, u3.a, u4.f, u5.p.x, u5.p.y, u6.i, u7.i, u8.inner.c, u9.f, u10.f,
           n11.value.i, u12.c, u13.f);

    return 0;
}

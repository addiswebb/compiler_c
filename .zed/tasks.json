        "command": "cmake --build build && ./build/compiler_c ./tests/test.c -ir",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
    {
        "label": "Compile -t",
        "command": "cmake --build build && ./build/compiler_c ./tests/test.c -t",
        "cwd": "$ZED_WORKTREE_ROOT",

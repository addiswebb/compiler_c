[
    {
        "label": "Build & Run Test.c",
        "command": "cmake --build build;./build/compiler_c ./tests/test.c -run -o ./tests/test.s;",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
    {
        "label": "Full Run Test.c",
        "command": "cmake --build build;./build/compiler_c ./tests/test.c -a;echo \"Compile and Run: ./tests/test.s\"; gcc ./tests/test.s -o ./tests/test.exe; ./tests/test.exe; echo \"Exit Code: $LASTEXITCODE - $?\"",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
    {
        "label": "Build",
        "command": "cmake --build build;./build/compiler_c ./tests/test.c -S",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
    {
        "label": "Run Tests",
        "command": "cmake --build build;lit -vv ./tests",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
    {
        "label": "Compile -ir",
        "command": "cmake --build build;./build/compiler_c ./tests/test.c -ir",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
    {
        "label": "Compile -t",
        "command": "cmake --build build;./build/compiler_c ./tests/test.c -t",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
]

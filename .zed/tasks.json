[
    {
        "label": "Rebuild CMake",
        "command": "cmake --fresh -S . -B build -G Ninja;cmake --build build",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
    {
        "label": "Full Run Test.c",
        "command": "cmake --build build;./build/compiler_c ./tests/test.c  -o ./tests/test.exe;./tests/test.exe; echo \"Exit Code: $LASTEXITCODE - $?\"",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
    {
        "label": "Build",
        "command": "cmake --build build;./build/compiler_c ./tests/test.c -o ./tests/test.exe",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
    {
        "label": "Run Tests",
        "command": "cmake --build build;lit -vv ./tests/basic ./tests/complex",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
    {
        "label": "Compile -ir",
        "command": "cmake --build build;./build/compiler_c ./tests/test.c -ir",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
    {
        "label": "Compile -ast",
        "command": "cmake --build build;./build/compiler_c ./tests/test.c -ast",
        "cwd": "$ZED_WORKTREE_ROOT",
        "use_new_terminal": false,
        "allow_concurrent_runs": false,
        "reveal": "always",
        "show_command": false,
    },
]
